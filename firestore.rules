rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gemini.genpro@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Digital store products: public catalog viewing with real-time updates for all clients
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Global store branding and announcements
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Indecopi virtual complaints book
    match /claims/{claimId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Admin authorization records
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
