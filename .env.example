# ==============================================================================
# ALICLIP STORE - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y completa los valores correspondientes
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR BACKEND & SEGURIDAD GEMINI AI
# ------------------------------------------------------------------------------
# Clave privada para Google GenAI en el servidor Express o Cloudflare Functions.
# CRÍTICO DE SEGURIDAD: Se configura ÚNICAMENTE en el servidor o Cloudflare Pages.
# NUNCA uses VITE_GEMINI_API_KEY. Al usar GEMINI_API_KEY, NUNCA se expone al cliente.
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# Puerto en el que se ejecuta el servidor Express backend (por defecto 3000)
PORT=3000

# URL pública donde está alojada la aplicación
APP_URL="https://tu-tienda.com"

# VITE_API_URL: (Opcional) Si despliegas el Frontend en Cloudflare Pages y un Backend separado.
# Déjalo vacío si usas Cloudflare Pages Functions (/functions/api/...) o modo full-stack Node.
VITE_API_URL=""

# ------------------------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE (CLIENTE WEB)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="TU_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto-id"
VITE_FIREBASE_DATABASE_URL="https://tu-proyecto-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef12345678"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 3. ACCESO ADMINISTRATIVO POR DEFECTO
# ------------------------------------------------------------------------------
VITE_ADMIN_DEFAULT_USER="admin"
VITE_ADMIN_DEFAULT_PASS="admin"

# ------------------------------------------------------------------------------
# 4. CONTACTO OFICIAL & WHATSAPP
# ------------------------------------------------------------------------------
VITE_STORE_NAME="Ali"
VITE_STORE_SUFFIX="clip"
VITE_STORE_SUBTITLE="Digital Store"
VITE_STORE_WHATSAPP_NUMBER="51900000000"
VITE_STORE_WHATSAPP_DISPLAY="+51 900 000 000"
VITE_STORE_ANNOUNCEMENT="Cuentas 100% garantizadas, renovables y soporte VIP 24/7"
VITE_STORE_CREATOR_URL="https://instagram.com/tu-usuario"
VITE_STORE_CREATOR_HANDLE="@tu-usuario"

# ------------------------------------------------------------------------------
# 5. MÉTODOS DE PAGO Y CUENTAS FINANCIERAS
# ------------------------------------------------------------------------------
VITE_PAYMENT_YAPE_NUMBER="+51 900 000 000"
VITE_PAYMENT_YAPE_HOLDER="AliClip Store Oficial"
VITE_PAYMENT_BINANCE_ID="849201938"
VITE_PAYMENT_BINANCE_HOLDER="AliClipPay (USDT)"
VITE_PAYMENT_BCP_ACCOUNT="191-99882211-0-45"
VITE_PAYMENT_BCP_HOLDER="AliClip Store E.I.R.L."
VITE_PAYMENT_INTERBANK_ACCOUNT="200-300400500-1"
VITE_PAYMENT_INTERBANK_HOLDER="AliClip Store Oficial"

# ------------------------------------------------------------------------------
# 6. FACTURACIÓN Y DATOS FISCALES (COMPROBANTES)
# ------------------------------------------------------------------------------
VITE_INVOICE_BUSINESS_NAME="AliClip Digital Services S.A.C."
VITE_INVOICE_TAX_ID="20608945123"
VITE_INVOICE_ADDRESS="Av. Javier Prado Este 4200, Santiago de Surco, Lima - Perú"
