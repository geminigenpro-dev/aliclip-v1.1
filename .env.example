# GEMINI_API_KEY: Clave secreta para la API de Gemini (SE MANTIENE ÚNICAMENTE EN EL BACKEND / SERVIDOR).
# NUNCA uses VITE_GEMINI_API_KEY en el cliente para evitar que se filtre en Cloudflare o en las herramientas del navegador.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto en el que se ejecuta el servidor Express backend (por defecto 3000)
PORT=3000

# APP_URL: URL pública donde está alojada la aplicación
APP_URL="MY_APP_URL"

# VITE_API_URL: (Opcional) Solo si despliegas el Frontend en Cloudflare Pages y el Backend en otro dominio separado.
# Déjalo vacío si ejecutas ambos en el mismo dominio o contenedor.
# VITE_API_URL="https://tu-backend.run.app"
