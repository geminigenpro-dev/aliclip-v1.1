# GEMINI_API_KEY: Clave secreta para la API de Gemini.
# CRÍTICO DE SEGURIDAD: Se configura ÚNICAMENTE en las variables de entorno de tu servidor o en Cloudflare Pages > Settings > Environment Variables.
# NUNCA uses VITE_GEMINI_API_KEY. Al usar GEMINI_API_KEY, NUNCA se expone en el código cliente de Vite ni a los usuarios.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto en el que se ejecuta el servidor Express backend (por defecto 3000)
PORT=3000

# APP_URL: URL pública donde está alojada la aplicación
APP_URL="MY_APP_URL"

# VITE_API_URL: (Opcional) Si despliegas el Frontend en Cloudflare Pages y un Backend Express separado.
# Déjalo vacío si usas Cloudflare Pages Functions (/functions/api/...) o si ejecutas full-stack con Node.
# VITE_API_URL=""

# VARIABLES OPCIONALES DE FIREBASE (Si prefieres usar variables de entorno en lugar del archivo local):
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

